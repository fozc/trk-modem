# Makefile for RF SCP application layer host tests
#
# Usage:
#   make -f Makefile.scp        - build test binary
#   make -f Makefile.scp run    - build and run tests
#   make -f Makefile.scp clean  - remove build artifacts
#
# Pure host build (gcc): rf_scp wire codec only. The request/response state
# machine lives in rf_process.c (Contiki/HAL) and is exercised on target.

CC := gcc
CFLAGS := -std=c11 -Wall -Wextra -Werror -Wshadow -Wconversion -O2 -g
BUILD_DIR := build_scp

# Directories
SRC_DIR := ..
LIBSCP_DIR := ../../libscp

# Include paths (rf_scp.h -> scp.h)
INCLUDES := -I$(SRC_DIR) -I$(LIBSCP_DIR)

# Sources
SCP_SRC := $(SRC_DIR)/rf_scp.c
TEST_SRC := test_rf_scp.c

# Objects
SCP_OBJ := $(BUILD_DIR)/rf_scp.o
TEST_OBJ := $(BUILD_DIR)/test_rf_scp.o

TARGET := $(BUILD_DIR)/test_rf_scp

.PHONY: all run clean

all: $(TARGET)

$(TARGET): $(SCP_OBJ) $(TEST_OBJ)
	$(CC) $(CFLAGS) -o $@ $^

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(SCP_OBJ): $(SCP_SRC) | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(TEST_OBJ): $(TEST_SRC) | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

run: $(TARGET)
	./$(TARGET)

clean:
	rm -rf $(BUILD_DIR)
