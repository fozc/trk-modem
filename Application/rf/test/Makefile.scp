# Makefile for RF SCP application layer host tests
#
# Usage:
#   make -f Makefile.scp        - build test binary
#   make -f Makefile.scp run    - build and run tests
#   make -f Makefile.scp clean  - remove build artifacts
#
# Pure host build (gcc): rf_scp_cmd + rf_scp_engine + injected time/packets.
# No HAL / Contiki dependency.

CC := gcc
CFLAGS := -std=c11 -Wall -Wextra -Werror -Wshadow -Wconversion -O2 -g
BUILD_DIR := build_scp

# Directories
SRC_DIR := ..
LIBSCP_DIR := ../../libscp

# Include paths (rf_scp_cmd.h / rf_scp_engine.h -> scp.h)
INCLUDES := -I$(SRC_DIR) -I$(LIBSCP_DIR)

# Sources
CMD_SRC := $(SRC_DIR)/rf_scp_cmd.c
ENGINE_SRC := $(SRC_DIR)/rf_scp_engine.c
TEST_SRC := test_rf_scp.c

# Objects
CMD_OBJ := $(BUILD_DIR)/rf_scp_cmd.o
ENGINE_OBJ := $(BUILD_DIR)/rf_scp_engine.o
TEST_OBJ := $(BUILD_DIR)/test_rf_scp.o

TARGET := $(BUILD_DIR)/test_rf_scp

.PHONY: all run clean

all: $(TARGET)

$(TARGET): $(CMD_OBJ) $(ENGINE_OBJ) $(TEST_OBJ)
	$(CC) $(CFLAGS) -o $@ $^

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(CMD_OBJ): $(CMD_SRC) | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(ENGINE_OBJ): $(ENGINE_SRC) | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(TEST_OBJ): $(TEST_SRC) | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

run: $(TARGET)
	./$(TARGET)

clean:
	rm -rf $(BUILD_DIR)
