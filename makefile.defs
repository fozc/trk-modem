# CubeIDE discovers Application/json through .cproject on regeneration.
# Keep existing generated Debug/Release makefiles usable until that happens.
ifeq ($(filter ./Application/json/json.o,$(OBJS)),)
USER_OBJS += ./Application/json/json.o
JSON_OPT_FLAGS := -Os
ifeq ($(notdir $(CURDIR)),Debug)
JSON_OPT_FLAGS := -Og -g3
endif

./Application/json/json.o: ../Application/json/json.c ../Application/json/json.h
	python -c "from pathlib import Path; Path('Application/json').mkdir(parents=True, exist_ok=True)"
	arm-none-eabi-gcc -mcpu=cortex-m33 -mthumb -mfpu=fpv5-sp-d16 -mfloat-abi=hard -std=c11 $(JSON_OPT_FLAGS) -ffunction-sections -fdata-sections -Wall -Wextra -Werror -Wshadow -Wconversion -Wdouble-promotion -Wformat=2 -fstack-usage -MMD -MP -c $< -o $@

-include Application/json/json.d
.DEFAULT_GOAL := all
endif

# Reuse CubeIDE's existing per-directory compile rules for sources added
# after an older generated Debug/Release source inventory was created.
ifeq ($(filter ./Application/bsp/bsp_rf_reset.o,$(OBJS)),)
USER_OBJS += ./Application/bsp/bsp_rf_reset.o
-include Application/bsp/bsp_rf_reset.d
endif
ifeq ($(filter ./Application/gsm/gsm_sms.o,$(OBJS)),)
USER_OBJS += ./Application/gsm/gsm_sms.o
-include Application/gsm/gsm_sms.d
endif
